{
  "name": "des-save-editor",
  "productName": "DeS Save Editor",
  "version": "0.0.0",
  "description": "Desktop shell for the offline Demon's Souls (PS5) save editor",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "author": "sekhnat",
  "scripts": {
    "start": "electron .",
    "test": "node test/smoke.mjs",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "io.github.sekhnat.des-save-editor",
    "files": ["main.js", "package.json"],
    "extraResources": [
      {"from": "../des_editor.html", "to": "des_editor.html"}
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {"output": "dist"},
    "win": {
      "target": [
        {"target": "portable", "arch": ["x64"]},
        {"target": "nsis", "arch": ["x64"]}
      ]
    },
    "portable": {"artifactName": "${productName}-${version}-${os}-${arch}-portable.${ext}"},
    "linux": {
      "target": [{"target": "AppImage", "arch": ["x64"]}],
      "category": "Utility"
    },
    "mac": {
      "target": [{"target": "dmg", "arch": ["x64", "arm64"]}],
      "category": "public.app-category.utilities",
      "identity": null
    }
  }
}
